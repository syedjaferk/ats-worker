# Copy to .env and fill in. Never commit .env, token.json or credentials.json.

# The portal, and the same ATS_WORKER_TOKEN as in the portal's .env
PORTAL_URL=https://learn.parottasalna.com
ATS_WORKER_TOKEN=

# Google Drive: simplest is the same token the portal uses (made by the portal's
#   manage.py drive_authorize), copied here. Or a token from  python -m ats_worker authorize,
#   or a service-account key.
DRIVE_CREDENTIALS=drive-token.json

# Local model. ollama (default) or openai (any OpenAI-compatible server: vLLM, llama.cpp, LM Studio)
LLM_BACKEND=ollama
LLM_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=                 # only if your OpenAI-compatible server wants one
# LLM_CONTEXT=16384            # Ollama num_ctx: resume + prompt + answer must fit
# LLM_TIMEOUT=600              # seconds per model call

# POLL_SECONDS=30              # how often to ask for work when the queue is empty
# MAX_PAGES=6                  # pages read per resume
# MAX_CHARS=20000              # characters of resume text sent to the model
# OCR=false                    # true: OCR scanned PDFs (apt install tesseract-ocr)
# LOG_LEVEL=INFO
